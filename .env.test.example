# E2E test configuration
# Copy this to `.env.test` and fill in real values. `.env.test` is gitignored.

# Base URL of the app under test (dev server or deployed preview)
E2E_BASE_URL=http://localhost:3000

# A real Supabase account to log in with (must exist in the test project)
E2E_EMAIL=your-test@example.com
E2E_PASSWORD=your-test-password
